# Copy to .env for local development:  make bootstrap
# Production MUST NOT use this file — secrets come from the secret manager / KMS.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
POLICY_FILE=/app/config/policy.default.yaml
REQUEST_DEADLINE_SECONDS=120
MAX_CONCURRENT_REQUESTS=16

DATABASE_URL=postgresql+asyncpg://privacy_gateway:change-me@postgres/privacy_gateway
# 32 raw bytes, base64-encoded. Generate with: python scripts/generate_dev_key.py
VAULT_MASTER_KEY_B64=development-only-placeholder
VAULT_HMAC_KEY_B64=development-only-placeholder
SCOPE_IDLE_TTL_SECONDS=7200
SCOPE_ABSOLUTE_TTL_SECONDS=86400
SCOPE_MAX_TURNS=50
SCOPE_MAX_FILES=20
SCOPE_MAX_BYTES=209715200
SCOPE_MAX_PAGES=200
SCOPE_MAX_MAPPINGS=5000
MAPPING_TTL_SECONDS=86400

LOCAL_MODEL_BASE_URL=http://local-model:8000/v1
LOCAL_MODEL_NAME=local-instruct-model
LOCAL_MODEL_TIMEOUT_SECONDS=20
LOCAL_MODEL_API_KEY=EMPTY

OCR_BACKEND=local
OCR_TIMEOUT_SECONDS=30

EXTERNAL_PROVIDER=openai-compatible
EXTERNAL_BASE_URL=http://fake-external:9100/v1
EXTERNAL_API_KEY=set-through-secret-manager
EXTERNAL_ALLOWED_MODELS=model-a,model-b,external-vlm-model
EXTERNAL_TIMEOUT_SECONDS=60

# Dev-only static bearer tokens, "token:tenant_id:principal_id:purpose1|purpose2".
# Production replaces this with mTLS / short-lived identity tokens.
DEV_STATIC_TOKENS=dev-token-1:tenant-a:svc-claims:general|medical_report_analysis

ENABLE_STREAMING=false
ENABLE_PAYLOAD_LOGGING=false

# "memory" for local development only; production is forced to "postgres".
STORAGE_BACKEND=memory
