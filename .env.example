# Copy to .env for local development:  make bootstrap
# Production MUST NOT use this file — secrets come from the secret manager / KMS.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
# Relative so the same value works both in the container (WORKDIR /app)
# and when running a script directly on a developer machine.
POLICY_FILE=config/policy.default.yaml
REQUEST_DEADLINE_SECONDS=120
MAX_CONCURRENT_REQUESTS=16

DATABASE_URL=postgresql+asyncpg://privacy_gateway:change-me@postgres/privacy_gateway
# 32 raw bytes, base64-encoded. Generate with: python scripts/generate_dev_key.py
VAULT_MASTER_KEY_B64=development-only-placeholder
VAULT_HMAC_KEY_B64=development-only-placeholder
SCOPE_IDLE_TTL_SECONDS=7200
SCOPE_ABSOLUTE_TTL_SECONDS=86400
SCOPE_MAX_TURNS=50
SCOPE_MAX_FILES=20
SCOPE_MAX_BYTES=209715200
SCOPE_MAX_PAGES=200
SCOPE_MAX_MAPPINGS=5000
MAPPING_TTL_SECONDS=86400

# Local detection assistant. This endpoint receives UNSANITIZED content (OCR
# text, document bodies), so it must stay inside the trusted zone.
# Note the /vllm path prefix: the bare host root serves a different application.
LOCAL_MODEL_BASE_URL=http://llm.zuche.com/vllm/v1
# Case-sensitive; must match an id from GET <base>/models exactly.
LOCAL_MODEL_NAME=Qwen3.8
LOCAL_MODEL_TIMEOUT_SECONDS=30
LOCAL_MODEL_API_KEY=set-in-dotenv-not-here
# Qwen3.8 is a reasoning model: it emits a chain of thought and leaves content
# null until it finishes. Span detection does not benefit from that, and a
# truncated answer would mean an incomplete entity list, so it is turned off.
LOCAL_MODEL_DISABLE_THINKING=true
LOCAL_MODEL_MAX_TOKENS=4096

OCR_BACKEND=local
OCR_TIMEOUT_SECONDS=30

EXTERNAL_PROVIDER=openai-compatible
# Include the API path prefix. A base URL missing it does not fail loudly: the
# host's web front end answers 200 with an HTML page, which looks like a working
# endpoint until the first real request.
EXTERNAL_BASE_URL=http://fake-external:9100/v1
EXTERNAL_API_KEY=set-through-secret-manager
EXTERNAL_ALLOWED_MODELS=model-a,model-b,external-vlm-model
EXTERNAL_TIMEOUT_SECONDS=60
# provider_default | disabled.
#
# Set to disabled for this deployment on measurement, not preference. On a real
# claims document (400 prompt tokens) against deepseek-v4-flash:
#
#   reasoning off, budget 4000    8.4s   798 completion tokens   1334 chars
#   reasoning on,  budget 8000   76.0s  8000 tokens, truncated      0 chars
#   reasoning on,  budget 16000 115.4s 12273 completion tokens    887 chars
#
# With reasoning on the model spends ~11,400 tokens deliberating before writing,
# produces nothing at all at the default budget, and at a budget that works sits
# at 115s against a 120s request deadline. The answer it eventually gives is not
# better — it was shorter and less structured than the one produced in 8 seconds.
#
# This is a finding about one provider on one task shape. Re-measure before
# assuming it holds elsewhere; the code default stays provider_default.
EXTERNAL_REASONING=disabled
# Models on EXTERNAL_ALLOWED_MODELS that accept image parts. Empty turns the
# check off, and the provider refuses instead — after the bytes have crossed the
# boundary for nothing. deepseek-v4-flash answers "This model does not support
# image"; check your own endpoint before listing a model here.
EXTERNAL_VISION_MODELS=

# Dev-only static bearer tokens, "token:tenant_id:principal_id:purpose1|purpose2".
# Production replaces this with mTLS / short-lived identity tokens.
DEV_STATIC_TOKENS=dev-token-1:tenant-a:svc-claims:general|medical_report_analysis

ENABLE_STREAMING=false
ENABLE_PAYLOAD_LOGGING=false

# "memory" for local development only; production is forced to "postgres".
STORAGE_BACKEND=memory
